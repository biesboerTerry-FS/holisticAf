{
  "folders": [
    {
      "name": "holisticAF-root",
      "path": "."
    },
    {
      "name": "frontend",
      "path": "client"
    },
    {
      "name": "backend",
      "path": "server"
    },
    {
      "name": "mobile",
      "path": "mobile"
    }
